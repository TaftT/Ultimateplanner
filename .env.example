# Copy this file to .env.local (already gitignored via the *.local pattern)
# and fill in the values from your Firebase project's Web App config
# (Project settings -> General -> Your apps -> SDK setup and configuration).
#
# If these are left unset, the app runs fully offline/local with no cloud
# sync UI shown at all — see src/firebase/config.js.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
